# ============================================================================
# NTU Mods by Bob Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive secrets
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ntu_mods?schema=public"

# ----------------------------------------------------------------------------
# JWT (JSON Web Token) CONFIGURATION
# ----------------------------------------------------------------------------
# Secret key for signing JWT tokens - MUST be a strong random string in production
# Generate with: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Token expiration times
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ----------------------------------------------------------------------------
# OAUTH CONFIGURATION
# ----------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------
PORT=3111
NODE_ENV="development"
COMPRESSION_ENABLED=true

# --- [LOCAL DEVELOPMENT] ---
# Uncomment this block for local development
PUBLIC_API_HOST="http://localhost"
# GOOGLE_REDIRECT_URI="http://localhost:3111/api/auth/google/callback"
# GITHUB_REDIRECT_URI="http://localhost:3111/api/auth/github/callback"

# --- [PRODUCTION] ---
# Uncomment this block for production deployment
# PUBLIC_API_HOST="https://yourdomain.com"
# PUBLIC_API_URL="https://yourdomain.com/api"
# GOOGLE_REDIRECT_URI="https://yourdomain.com/api/auth/google/callback"
# GITHUB_REDIRECT_URI="https://yourdomain.com/api/auth/github/callback"

# ----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins (frontend URLs)
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW="15m"
RATE_LIMIT_MAX="100"
RATE_LIMIT_AUTH_MAX="1000"

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# ----------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="NTU Mods by Bob <noreply@example.com>"

# ----------------------------------------------------------------------------
# EXTERNAL DATA SOURCE (University API)
# ----------------------------------------------------------------------------
EXTERNAL_API_URL="https://api.university.edu/modules"
EXTERNAL_API_KEY="your-api-key-here"

# ----------------------------------------------------------------------------
# DATA SYNC CONFIGURATION
# ----------------------------------------------------------------------------
SYNC_CRON_SCHEDULE="0 2 * * *"
SYNC_ENABLED=true
SYNC_ON_STARTUP=true

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL="info"

# ----------------------------------------------------------------------------
# SWAGGER/API DOCUMENTATION
# ----------------------------------------------------------------------------
SWAGGER_ENABLED=true

# ----------------------------------------------------------------------------
# REDIS CACHE CONFIGURATION
# ----------------------------------------------------------------------------
REDIS_ENABLED=false
# REDIS_URL="redis://user:password@localhost:6379/0"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX="ntu-mods:"
CACHE_DEFAULT_TTL_SECONDS=900

