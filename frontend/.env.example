# ==================================
# Frontend Environment
# ==================================
# Copy this file to frontend/.env and set values for your environment.

# Server
PORT=3000
NEXT_PUBLIC_APP_HOST=http://localhost

# Public browser URL (required by the application configuration)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API
BACKEND_API_URL=http://localhost:3111/api
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Branding
NEXT_PUBLIC_APP_NAME=NTU Mods by Bob
NEXT_PUBLIC_APP_TITLE=Academic Planner
NEXT_PUBLIC_APP_TAGLINE=Plan modules with confidence
NEXT_PUBLIC_APP_DESCRIPTION=Plan modules, compare timetables, and manage your study plan in one place.
NEXT_PUBLIC_DONATION_URL=https://ko-fi.com/

# Optional external links
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_REPO_ISSUES_URL=

# Feature flags
NEXT_PUBLIC_FEATURE_GUEST_MODE=true
NEXT_PUBLIC_FEATURE_CSV=true

# Limits
NEXT_PUBLIC_LIMIT_MAX_PLANNING_YEARS=6
NEXT_PUBLIC_LIMIT_MAX_MODULES_PER_SEM=10
NEXT_PUBLIC_LIMIT_MAX_SAVED_TIMETABLES=10
